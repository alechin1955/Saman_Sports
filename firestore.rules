rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function rol() {
      return userDoc().data.get('rol', '');
    }

    // Un documento sin `estado` se trata como activo. `inactivo` corta el acceso.
    function activo() {
      return isSignedIn() && userDoc().data.get('estado', 'activo') != 'inactivo';
    }

    function isAdmin() {
      return activo() && rol() == 'administrador';
    }

    function isEntrenador() {
      return activo() && rol() == 'entrenador';
    }

    function isEstudiante() {
      return activo() && rol() == 'estudiante';
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function noToca(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    function deporteDe(deporteId) {
      return get(/databases/$(database)/documents/deportes/$(deporteId)).data;
    }

    function esSuDeporte(deporteId) {
      return isEntrenador() && deporteDe(deporteId).entrenadorUid == request.auth.uid;
    }

    function pathInscripcion(deporteId) {
      return /databases/$(database)/documents/inscripciones/$(request.auth.uid + '_' + deporteId);
    }

    function pathDeporte(deporteId) {
      return /databases/$(database)/documents/deportes/$(deporteId);
    }

    // El administrador marca `solvente`. Si falta el campo, no está solvente.
    function esSolvente() {
      return userDoc().data.solvente == true;
    }

    function deporteActivo(deporteId) {
      return exists(pathDeporte(deporteId))
        && get(pathDeporte(deporteId)).data.activo == true;
    }

    function subeUnInscrito(deporteId) {
      return getAfter(pathDeporte(deporteId)).data.inscritos
        == get(pathDeporte(deporteId)).data.inscritos + 1;
    }

    function bajaUnInscrito(deporteId) {
      return getAfter(pathDeporte(deporteId)).data.inscritos
        == get(pathDeporte(deporteId)).data.inscritos - 1;
    }

    match /usuarios/{userId} {
      // El propio documento se puede leer aunque esté inactivo: el login
      // necesita ver `estado`. El resto de lecturas privadas sí exigen activo().
      // TEMPORAL: el entrenador lee alumnos para mostrar el nombre. Expone
      // cédula y teléfono. Cerrar cuando el nombre viva en la inscripción.
      allow get: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (isEntrenador() && resource.data.rol == 'estudiante');

      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow create: if (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.rol == 'estudiante'
          && request.resource.data.get('estado', 'activo') == 'activo'
          && request.resource.data.get('solvente', false) == false
        ) || (
          isAdmin()
          && request.resource.data.rol == 'entrenador'
          && request.resource.data.estado == 'activo'
        );

      allow update: if isAdmin() || (
          isSignedIn()
          && activo()
          && request.auth.uid == userId
          && noToca(['rol', 'estado', 'solvente', 'cedula', 'carnet'])
        );

      allow delete: if false;
    }

    match /deportes/{deporteId} {
      allow read: if resource.data.activo == true
        || isAdmin()
        || (isEntrenador() && resource.data.entrenadorUid == request.auth.uid);

      allow create, delete: if isAdmin();

      // El panel no escribe el documento raíz. Solo puede tocar `descripcion`
      // y no puede reasignarse la disciplina ni cambiar cupos, estado o cancha.
      // El estudiante solo mueve `inscritos` en 1, y solo en la misma
      // transacción en que crea o cancela su propia inscripción.
      allow update: if isAdmin() || (
          isEntrenador()
          && resource.data.entrenadorUid == request.auth.uid
          && request.resource.data.entrenadorUid == request.auth.uid
          && soloCambia(['descripcion'])
        ) || (
          isEstudiante()
          && soloCambia(['inscritos'])
          && request.resource.data.inscritos is int
          && (
            (
              request.resource.data.inscritos == resource.data.get('inscritos', 0) + 1
              && request.resource.data.inscritos <= resource.data.cupos
              && (!exists(pathInscripcion(deporteId))
                || get(pathInscripcion(deporteId)).data.estado == 'cancelada')
              && getAfter(pathInscripcion(deporteId)).data.estado == 'pendiente'
            ) || (
              request.resource.data.inscritos == resource.data.get('inscritos', 0) - 1
              && request.resource.data.inscritos >= 0
              && get(pathInscripcion(deporteId)).data.estado in ['pendiente', 'confirmada']
              && getAfter(pathInscripcion(deporteId)).data.estado == 'cancelada'
            )
          )
        );

      match /asistencias/{fecha} {

        // El estudiante lee la asistencia solo si su inscripción sigue
        // pendiente o confirmada, para ver su porcentaje en el Historial (RF-14).
        allow read: if isAdmin() || esSuDeporte(deporteId) || (
          isEstudiante()
          && get(pathInscripcion(deporteId)).data.estado in ['pendiente', 'confirmada']
        );

        allow create: if esSuDeporte(deporteId)
          && deporteDe(deporteId).activo == true
          && request.resource.data.entrenadorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'fecha', 'entrenadorUid', 'estados', 'actualizadoEn'
          ]);

        allow update: if esSuDeporte(deporteId)
          && deporteDe(deporteId).activo == true
          && request.resource.data.entrenadorUid == request.auth.uid
          && soloCambia(['fecha', 'entrenadorUid', 'estados', 'actualizadoEn']);

        allow delete: if false;
      }
    }

    match /entrenadores/{id} {
      allow read: if resource.data.activo == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
          isEntrenador()
          && request.auth.uid == id
          && soloCambia(['biografia', 'anosExperiencia', 'certificaciones'])
        );
    }

    // El campo real es `activa`, no `activo`.
    // TEMPORAL: el entrenador lista todas, también inactivas, para mostrar
    // "cancha inactiva" en vez de un error de permisos. Cerrar con
    // where activa == true en streamCanchasEntrenador.
    match /canchas/{id} {
      allow read: if resource.data.activa == true || isAdmin() || isEntrenador();
      allow create, update, delete: if isAdmin();
    }

    // `eventos` no tiene campo `activo`. La portada no los lista.
    // El entrenador crea solicitudes pendientes de su disciplina y lee las suyas.
    function eventoDoc(eventoId) {
      return get(/databases/$(database)/documents/eventos/$(eventoId)).data;
    }

    function camposAviso() {
      return request.resource.data.keys().hasOnly([
          'destinatarioUid', 'destinatarioRol', 'origenUid', 'tipo', 'titulo', 'mensaje',
          'leida', 'fecha', 'inscripcionId', 'pagoId', 'eventoId', 'ticketId', 'deporteId'
        ])
        && request.resource.data.leida == false
        && request.resource.data.fecha == request.time;
    }

    function rutaDe(coleccion, docId) {
      return /databases/$(database)/documents/$(coleccion)/$(docId);
    }

    function escritoAhora(coleccion, docId) {
      let ruta = rutaDe(coleccion, docId);
      return !exists(ruta) || get(ruta).data.diff(getAfter(ruta).data).affectedKeys().size() > 0;
    }

    function inscripcionDespues(inscripcionId) {
      return getAfter(/databases/$(database)/documents/inscripciones/$(inscripcionId)).data;
    }

    function usuarioDespues() {
      return getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function avisoPropioInscripcion() {
      return isEstudiante() && camposAviso()
        && request.resource.data.destinatarioUid == request.auth.uid
        && request.resource.data.inscripcionId is string
        && escritoAhora('inscripciones', request.resource.data.inscripcionId)
        && inscripcionDespues(request.resource.data.inscripcionId).estudianteUid == request.auth.uid
        && (
          (request.resource.data.tipo == 'inscripcion_creada'
            && inscripcionDespues(request.resource.data.inscripcionId).estado == 'pendiente')
          || (request.resource.data.tipo == 'inscripcion_cancelada'
            && inscripcionDespues(request.resource.data.inscripcionId).estado == 'cancelada')
        );
    }

    function avisoParaAdmin() {
      let d = request.resource.data;
      return isSignedIn() && camposAviso()
        && d.destinatarioRol == 'administrador' && d.destinatarioUid == ''
        && d.origenUid == request.auth.uid
        && usuarioDespues().get('estado', 'activo') != 'inactivo'
        && (
          (d.tipo == 'inscripcion_pendiente' && usuarioDespues().rol == 'estudiante'
            && d.inscripcionId is string
            && escritoAhora('inscripciones', d.inscripcionId)
            && inscripcionDespues(d.inscripcionId).estudianteUid == request.auth.uid
            && inscripcionDespues(d.inscripcionId).estado == 'pendiente')
          || (d.tipo == 'pago_enviado' && usuarioDespues().rol == 'estudiante'
            && d.pagoId is string
            && escritoAhora('pagos', d.pagoId)
            && getAfter(/databases/$(database)/documents/pagos/$(d.pagoId)).data.estudianteUid == request.auth.uid)
          || (d.tipo == 'solicitud_evento' && usuarioDespues().rol == 'entrenador'
            && d.eventoId is string
            && escritoAhora('eventos', d.eventoId)
            && getAfter(/databases/$(database)/documents/eventos/$(d.eventoId)).data.creadoPorUid == request.auth.uid)
          || (d.tipo == 'ticket_nuevo' && usuarioDespues().rol in ['estudiante', 'entrenador']
            && d.ticketId is string
            && escritoAhora('tickets', d.ticketId)
            && getAfter(/databases/$(database)/documents/tickets/$(d.ticketId)).data.autorUid == request.auth.uid)
          || (d.tipo == 'registro_estudiante' && usuarioDespues().rol == 'estudiante'
            && escritoAhora('usuarios', request.auth.uid))
        );
    }

    match /eventos/{id} {
      allow read: if isAdmin()
        || resource.data.get('activo', false) == true
        || (activo() && resource.data.estado == 'aprobado')
        || (isEntrenador() && resource.data.creadoPorUid == request.auth.uid);

      match /participantes/{uid} {
        allow read: if isAdmin()
          || (activo() && request.auth.uid == uid)
          || (eventoDoc(id).get('deporteId', null) is string && esSuDeporte(eventoDoc(id).deporteId));
        allow create, update: if isEstudiante()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['estudianteUid', 'estado', 'fecha'])
          && request.resource.data.estudianteUid == uid
          && request.resource.data.estado in ['confirmado', 'rechazado']
          && request.resource.data.fecha == request.time
          && eventoDoc(id).estado == 'aprobado'
          && eventoDoc(id).get('deporteId', null) is string
          && get(/databases/$(database)/documents/inscripciones/$(uid + '_' + eventoDoc(id).deporteId)).data.estado in ['pendiente', 'confirmada'];
        allow delete: if false;
      }

      allow create: if isAdmin() || (
          isEntrenador()
          && request.resource.data.creadoPorUid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.deporteId is string
          && deporteDe(request.resource.data.deporteId).entrenadorUid == request.auth.uid
          && deporteDe(request.resource.data.deporteId).activo == true
        );

      allow delete: if isAdmin();
      allow update: if isAdmin() || (
          isEntrenador()
          && resource.data.creadoPorUid == request.auth.uid
          && request.resource.data.creadoPorUid == request.auth.uid
          && resource.data.estado == 'pendiente'
          && (
            (
              request.resource.data.estado == 'cancelado'
              && soloCambia(['estado', 'actualizadoEn'])
            ) || (
              request.resource.data.estado == 'pendiente'
              && soloCambia(['titulo', 'descripcion', 'fecha', 'horaInicio', 'horaFin',
                             'capacidad', 'canchaId', 'canchaNombre', 'ubicacion', 'actualizadoEn'])
              && deporteDe(resource.data.deporteId).entrenadorUid == request.auth.uid
            )
          )
        );
    }

    match /resenas/{id} {
      allow read: if resource.data.visible == true
        || isAdmin()
        || (activo() && resource.data.autorUid == request.auth.uid);

      allow create: if isEstudiante()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.visible == true
        && request.resource.data.deporteId is string
        && exists(pathInscripcion(request.resource.data.deporteId))
        && get(pathInscripcion(request.resource.data.deporteId)).data.estado == 'confirmada';

      allow update: if (isAdmin() && soloCambia(['visible']))
        || (
          isEstudiante()
          && resource.data.autorUid == request.auth.uid
          && noToca(['visible', 'autorUid'])
        );

      allow delete: if isAdmin()
        || (isEstudiante() && resource.data.autorUid == request.auth.uid);
    }

    // No existe un uid de dueño en `reservas`. Las crea el admin.
    // El entrenador lee las activas: su consulta filtra canchaId + activa.
    match /reservas/{id} {
      allow read: if isAdmin() || (isEntrenador() && resource.data.activa == true);
      allow create, update, delete: if isAdmin();
    }

    match /pagos/{id} {
      allow read: if isAdmin()
        || (isEstudiante() && resource.data.estudianteUid == request.auth.uid);

      allow create: if isEstudiante()
        && request.resource.data.estudianteUid == request.auth.uid
        && request.resource.data.verificado == false
        && request.resource.data.get('estado', 'pendiente') != 'realizado';

      // TEMPORAL: quitar cuando exista la Cloud Function de PayPal.
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /inscripciones/{id} {
      // La transacción de inscripción del estudiante lee {uid}_{deporteId}
      // antes de que exista (resource == null).
      allow get: if isAdmin()
        || (isEstudiante() && resource.data.estudianteUid == request.auth.uid)
        || (
          isEstudiante()
          && resource == null
          && id.matches(request.auth.uid + '_.+')
        )
        || (
          isEntrenador()
          && resource.data.deporteId is string
          && esSuDeporte(resource.data.deporteId)
        );

      // TEMPORAL: un list no puede comprobar el deporte padre. Cualquier
      // entrenador activo puede listar por deporteId, no solo el asignado.
      // Cerrar guardando entrenadorUid en la inscripción y filtrando por él.
      allow list: if isAdmin()
        || (isEstudiante() && resource.data.estudianteUid == request.auth.uid)
        || (isEntrenador() && resource.data.deporteId is string);

      // El estudiante crea su inscripción pendiente con id {uid}_{deporteId}
      // (RF-04). No puede confirmarla: eso lo hace el administrador.
      allow create: if isAdmin() || (
          isEstudiante()
          && id == request.auth.uid + '_' + request.resource.data.deporteId
          && request.resource.data.estudianteUid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.fecha == request.time
          && request.resource.data.keys().hasOnly([
            'estudianteUid', 'deporteId', 'deporteNombre', 'estado', 'fecha'
          ])
          && deporteActivo(request.resource.data.deporteId)
          && esSolvente()
          && subeUnInscrito(request.resource.data.deporteId)
        );

      // El estudiante solo cancela la suya (RF-05) o, si estaba cancelada,
      // vuelve a pedirla como pendiente.
      allow update: if isAdmin() || (
          isEstudiante()
          && resource.data.estudianteUid == request.auth.uid
          && request.resource.data.estudianteUid == request.auth.uid
          && request.resource.data.deporteId == resource.data.deporteId
          && (
            (
              resource.data.estado in ['pendiente', 'confirmada']
              && request.resource.data.estado == 'cancelada'
              && soloCambia(['estado'])
              && (
                bajaUnInscrito(resource.data.deporteId)
                || (
                  get(pathDeporte(resource.data.deporteId)).data.get('inscritos', 0) == 0
                  && getAfter(pathDeporte(resource.data.deporteId)).data.get('inscritos', 0) == 0
                )
              )
            ) || (
              resource.data.estado == 'cancelada'
              && request.resource.data.estado == 'pendiente'
              && request.resource.data.fecha == request.time
              && soloCambia(['estado', 'fecha', 'deporteNombre'])
              && deporteActivo(resource.data.deporteId)
              && esSolvente()
              && subeUnInscrito(resource.data.deporteId)
            )
          )
        );

      allow delete: if isAdmin();
    }
    
    match /transacciones/{id} {
      allow read: if isAdmin()
        || (activo() && resource.data.usuarioUid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /notificaciones/{id} {
      allow read: if isAdmin()
        || (activo() && resource.data.destinatarioUid == request.auth.uid);

      allow create: if isAdmin() || avisoPropioInscripcion() || avisoParaAdmin();

      allow update: if soloCambia(['leida']) && (
          (activo() && resource.data.destinatarioUid == request.auth.uid)
          || (isAdmin() && resource.data.get('destinatarioRol', '') == 'administrador')
        );

      allow delete: if false;
    }

    match /eventosPublicos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'titulo', 'tipo', 'deporteId', 'deporteNombre', 'canchaNombre',
          'fecha', 'horaInicio', 'horaFin', 'descripcion', 'actualizadoEn'
        ]);
      allow delete: if isAdmin();
    }

    // La colección real de soporte es `tickets`, no `soporte`.
    // Solo el admin cambia respuesta, estado y resueltoEn.
    match /tickets/{id} {
      allow read: if isAdmin()
        || (
          (isEstudiante() || isEntrenador())
          && resource.data.autorUid == request.auth.uid
        );

      allow create: if (isEstudiante() || isEntrenador())
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorRol == rol()
        && request.resource.data.estado == 'abierto'
        && request.resource.data.respuesta == ''
        && request.resource.data.resueltoEn == null;

      allow update: if isAdmin()
        && soloCambia(['respuesta', 'estado', 'resueltoEn']);

      allow delete: if false;
    }

    match /configuracion/{id} {
      allow read: if isSignedIn() && activo();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /identificadores/{id} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if (
          isSignedIn()
          && request.resource.data.keys().hasOnly(['uid', 'tipo', 'creadoEn'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tipo in ['cedula', 'carnet']
          && request.resource.data.creadoEn == request.time
          && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') == 'estudiante'
          && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('estado', 'activo') != 'inactivo'
          && (
            id == request.resource.data.tipo + '_'
              + getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get(request.resource.data.tipo, '')
            || (
              request.resource.data.tipo == 'cedula'
              && id.matches('^cedula_([VE]-)?[0-9]+$')
              && ('cedula_' + getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('cedula', '')).matches('(?i)^' + id + '$')
            )
          )
        ) || (
          isAdmin()
          && request.resource.data.keys().hasOnly(['uid', 'tipo', 'creadoEn'])
          && request.resource.data.tipo in ['cedula', 'carnet']
        );
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
